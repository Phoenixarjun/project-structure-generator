{
  "schemaVersion": 1,
  "id": "python-django-apps",
  "version": "1.0.0",
  "name": "Django Apps",
  "description": "Django project structure organized by app directories.",
  "projectType": "backend-service",
  "language": "python",
  "framework": "django",
  "organization": "apps",
  "supportedMaturities": ["prototype", "standard", "operational"],
  "defaultMaturity": "standard",
  "supportedCapabilities": [
    "unit-tests",
    "integration-tests",
    "docker",
    "docker-compose",
    "github-actions",
    "postgres",
    "redis",
    "structured-logging",
    "opentelemetry",
    "documentation-showcase"
  ],
  "variables": [
    {
      "name": "projectName",
      "prompt": "Project name",
      "type": "string",
      "required": true,
      "transform": "kebab"
    },
    {
      "name": "pythonPackageName",
      "prompt": "Python package name",
      "type": "string",
      "default": "{{projectName}}",
      "transform": "snake"
    }
  ],
  "featureTemplate": {
    "variables": ["featureName"],
    "entries": [
      {
        "type": "directory",
        "path": "src/apps/{{featureNameSnake}}"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/__init__.py",
        "content": ""
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/apps.py",
        "content": "from django.apps import AppConfig\n\nclass {{featureNamePascal}}Config(AppConfig):\n    name = 'src.apps.{{featureNameSnake}}'\n"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/models.py",
        "content": "from django.db import models\n"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/views.py",
        "content": "from django.http import JsonResponse\n\ndef index(request):\n    return JsonResponse({'app': '{{featureNameSnake}}'})\n"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/urls.py",
        "content": "from django.urls import path\nfrom . import views\n\nurlpatterns = [\n    path('', views.index, name='index'),\n]\n"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/tests.py",
        "content": "from django.test import TestCase\n\nclass {{featureNamePascal}}TestCase(TestCase):\n    def test_sample(self):\n        self.assertTrue(True)\n"
      }
    ]
  },
  "entries": [
    {
      "type": "directory",
      "path": "src/apps"
    },
    {
      "type": "file",
      "path": "pyproject.toml",
      "source": "template/pyproject.toml"
    },
    {
      "type": "file",
      "path": "manage.py",
      "source": "template/manage.py"
    },
    {
      "type": "file",
      "path": "README.md",
      "source": "template/README.md"
    },
    {
      "type": "file",
      "path": ".gitignore",
      "source": "template/gitignore"
    },
    {
      "type": "file",
      "path": "src/config/__init__.py",
      "source": "template/src/config/__init__.py"
    },
    {
      "type": "file",
      "path": "src/config/urls.py",
      "source": "template/src/config/urls.py"
    },
    {
      "type": "file",
      "path": "src/config/settings/__init__.py",
      "source": "template/src/config/settings/__init__.py"
    },
    {
      "type": "file",
      "path": "src/config/settings/base.py",
      "source": "template/src/config/settings/base.py"
    }
  ]
}
