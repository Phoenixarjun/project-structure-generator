{
  "schemaVersion": 1,
  "id": "react-feature-based",
  "version": "1.0.0",
  "name": "React Feature-Based",
  "description": "Production React application with feature-based encapsulation and public API boundaries.",
  "projectType": "frontend-application",
  "language": "typescript",
  "framework": "react",
  "organization": "feature-based",
  "supportedMaturities": ["prototype", "standard", "operational"],
  "defaultMaturity": "operational",
  "supportedCapabilities": [
    "unit-tests",
    "integration-tests",
    "github-actions",
    "docker",
    "structured-logging",
    "documentation-showcase"
  ],
  "incompatibleCapabilities": ["postgres", "redis", "kafka"],
  "variables": [
    {
      "name": "projectName",
      "prompt": "Project name",
      "type": "string",
      "required": true,
      "transform": "kebab"
    }
  ],
  "featureTemplate": {
    "entries": [
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}/api"
      },
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}/components"
      },
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}/types"
      },
      {
        "type": "file",
        "path": "src/features/{{featureNameKebab}}/index.ts",
        "content": "// Public Feature API for {{featureNameKebab}}\nexport * from './components/FeatureWidget';\n"
      },
      {
        "type": "file",
        "path": "src/features/{{featureNameKebab}}/components/FeatureWidget.tsx",
        "content": "export function FeatureWidget() {\n  return <div>Feature: {{featureNameKebab}}</div>;\n}\n"
      }
    ]
  },
  "entries": [
    {
      "type": "directory",
      "path": "src/components/ui"
    },
    {
      "type": "directory",
      "path": "src/components/shared"
    },
    {
      "type": "directory",
      "path": "src/lib"
    },
    {
      "type": "directory",
      "path": "src/services"
    },
    {
      "type": "directory",
      "path": "src/config"
    },
    {
      "type": "file",
      "path": "package.json",
      "source": "template/package.json"
    },
    {
      "type": "file",
      "path": "tsconfig.json",
      "source": "template/tsconfig.json"
    },
    {
      "type": "file",
      "path": "vite.config.ts",
      "source": "template/vite.config.ts"
    },
    {
      "type": "file",
      "path": "index.html",
      "source": "template/index.html"
    },
    {
      "type": "file",
      "path": "README.md",
      "source": "template/README.md"
    },
    {
      "type": "file",
      "path": ".gitignore",
      "source": "template/gitignore"
    },
    {
      "type": "file",
      "path": "src/main.tsx",
      "source": "template/src/main.tsx"
    },
    {
      "type": "file",
      "path": "src/app/App.tsx",
      "source": "template/src/app/App.tsx"
    }
  ]
}
