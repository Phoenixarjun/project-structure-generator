{
  "schemaVersion": 1,
  "id": "react-feature-based",
  "version": "1.0.0",
  "name": "React Feature-Based",
  "description": "Production React application with feature-based encapsulation and public API boundaries.",
  "projectType": "frontend-application",
  "language": "typescript",
  "framework": "react",
  "organization": "feature-based",
  "supportedMaturities": ["prototype", "standard", "operational"],
  "defaultMaturity": "operational",
  "supportedCapabilities": [
    "unit-tests",
    "integration-tests",
    "github-actions",
    "docker",
    "structured-logging",
    "documentation-showcase"
  ],
  "incompatibleCapabilities": ["postgres", "redis", "kafka"],
  "variables": [
    {
      "name": "projectName",
      "prompt": "Project name",
      "type": "string",
      "required": true,
      "transform": "kebab"
    }
  ],
  "featureTemplate": {
    "variables": ["featureName"],
    "entries": [
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}"
      },
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}/api"
      },
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}/components"
      },
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}/hooks"
      },
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}/schemas"
      },
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}/types"
      },
      {
        "type": "directory",
        "path": "src/features/{{featureNameKebab}}/tests"
      },
      {
        "type": "file",
        "path": "src/features/{{featureNameKebab}}/index.ts",
        "content": "export * from './components/{{featureNamePascal}}View';\nexport * from './hooks/use{{featureNamePascal}}';\nexport * from './types';\n"
      },
      {
        "type": "file",
        "path": "src/features/{{featureNameKebab}}/api/client.ts",
        "content": "import { environment } from '../../../config/environment';\n\nexport async function fetch{{featureNamePascal}}Data() {\n  const res = await fetch(`${environment.apiBaseUrl}/{{featureNameKebab}}`);\n  return res.json();\n}\n"
      },
      {
        "type": "file",
        "path": "src/features/{{featureNameKebab}}/components/{{featureNamePascal}}View.tsx",
        "content": "import React from 'react';\nimport { use{{featureNamePascal}} } from '../hooks/use{{featureNamePascal}}';\n\nexport function {{featureNamePascal}}View() {\n  const { data, loading } = use{{featureNamePascal}}();\n  if (loading) return <div>Loading...</div>;\n  return <div className=\"{{featureNameKebab}}-view\">Feature: {data}</div>;\n}\n"
      },
      {
        "type": "file",
        "path": "src/features/{{featureNameKebab}}/hooks/use{{featureNamePascal}}.ts",
        "content": "import { useState, useEffect } from 'react';\nimport { fetch{{featureNamePascal}}Data } from '../api/client';\n\nexport function use{{featureNamePascal}}() {\n  const [data, setData] = useState<string>('{{featureNameKebab}}');\n  const [loading, setLoading] = useState<boolean>(false);\n  return { data, loading };\n}\n"
      },
      {
        "type": "file",
        "path": "src/features/{{featureNameKebab}}/schemas/{{featureNameKebab}}.schema.ts",
        "content": "export interface {{featureNamePascal}}Schema {\n  id: string;\n  name: string;\n}\n"
      },
      {
        "type": "file",
        "path": "src/features/{{featureNameKebab}}/types/index.ts",
        "content": "export interface {{featureNamePascal}}Item {\n  id: string;\n  name: string;\n}\n"
      },
      {
        "type": "file",
        "path": "src/features/{{featureNameKebab}}/tests/{{featureNamePascal}}View.test.tsx",
        "content": "import React from 'react';\nimport { {{featureNamePascal}}View } from '../components/{{featureNamePascal}}View';\n\nexport function test{{featureNamePascal}}View() {\n  if (typeof {{featureNamePascal}}View !== 'function') {\n    throw new Error('{{featureNamePascal}}View is not defined');\n  }\n}\n"
      }
    ]
  },
  "entries": [
    {
      "type": "directory",
      "path": "src/app"
    },
    {
      "type": "directory",
      "path": "src/components/ui"
    },
    {
      "type": "directory",
      "path": "src/components/shared"
    },
    {
      "type": "directory",
      "path": "src/features"
    },
    {
      "type": "directory",
      "path": "src/hooks"
    },
    {
      "type": "directory",
      "path": "src/lib"
    },
    {
      "type": "directory",
      "path": "src/services"
    },
    {
      "type": "directory",
      "path": "src/config"
    },
    {
      "type": "directory",
      "path": "src/types"
    },
    {
      "type": "file",
      "path": "package.json",
      "source": "template/package.json"
    },
    {
      "type": "file",
      "path": "tsconfig.json",
      "source": "template/tsconfig.json"
    },
    {
      "type": "file",
      "path": "vite.config.ts",
      "source": "template/vite.config.ts"
    },
    {
      "type": "file",
      "path": "index.html",
      "source": "template/index.html"
    },
    {
      "type": "file",
      "path": "README.md",
      "source": "template/README.md"
    },
    {
      "type": "file",
      "path": ".gitignore",
      "source": "template/gitignore"
    },
    {
      "type": "file",
      "path": ".env.example",
      "source": "template/env.example"
    },
    {
      "type": "file",
      "path": "src/main.tsx",
      "source": "template/src/main.tsx"
    },
    {
      "type": "file",
      "path": "src/vite-env.d.ts",
      "source": "template/src/vite-env.d.ts"
    },
    {
      "type": "file",
      "path": "src/app/App.tsx",
      "source": "template/src/app/App.tsx"
    },
    {
      "type": "file",
      "path": "src/app/providers.tsx",
      "source": "template/src/app/providers.tsx"
    },
    {
      "type": "file",
      "path": "src/app/routes.tsx",
      "source": "template/src/app/routes.tsx"
    },
    {
      "type": "file",
      "path": "src/components/ui/README.md",
      "source": "template/src/components/ui/README.md"
    },
    {
      "type": "file",
      "path": "src/components/shared/README.md",
      "source": "template/src/components/shared/README.md"
    },
    {
      "type": "file",
      "path": "src/config/environment.ts",
      "source": "template/src/config/environment.ts"
    },
    {
      "type": "file",
      "path": "src/features/README.md",
      "content": "# Features Directory\n\nOrganize business domain modules here.\n"
    }
  ]
}
