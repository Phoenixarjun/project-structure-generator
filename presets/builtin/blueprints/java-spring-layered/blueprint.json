{
  "schemaVersion": 1,
  "id": "java-spring-layered",
  "version": "1.0.0",
  "name": "Java Spring Boot Layered",
  "description": "Layered Java Spring Boot service using Gradle Kotlin DSL.",
  "projectType": "backend-service",
  "language": "java",
  "framework": "spring-boot",
  "organization": "layered",
  "supportedMaturities": ["prototype", "standard", "operational"],
  "defaultMaturity": "standard",
  "supportedCapabilities": [
    "unit-tests",
    "integration-tests",
    "docker",
    "docker-compose",
    "github-actions",
    "postgres",
    "redis",
    "kafka",
    "structured-logging",
    "opentelemetry",
    "documentation-showcase"
  ],
  "variables": [
    {
      "name": "projectName",
      "prompt": "Project name",
      "type": "string",
      "required": true,
      "transform": "kebab"
    },
    {
      "name": "groupId",
      "prompt": "Maven group ID",
      "type": "string",
      "default": "com.example"
    },
    {
      "name": "artifactId",
      "prompt": "Maven artifact ID",
      "type": "string",
      "default": "{{projectName}}",
      "transform": "kebab"
    },
    {
      "name": "javaPackage",
      "prompt": "Java base package name",
      "type": "string",
      "default": "{{groupId}}.{{projectNameCamel}}"
    },
    {
      "name": "generateServiceInterfaces",
      "prompt": "Generate explicit service interfaces?",
      "type": "boolean",
      "default": false
    }
  ],
  "entries": [
    {
      "type": "directory",
      "path": "src/main/java/{{javaPackagePath}}/repository"
    },
    {
      "type": "directory",
      "path": "src/main/java/{{javaPackagePath}}/model"
    },
    {
      "type": "directory",
      "path": "src/main/java/{{javaPackagePath}}/dto"
    },
    {
      "type": "directory",
      "path": "src/main/java/{{javaPackagePath}}/mapper"
    },
    {
      "type": "directory",
      "path": "src/main/java/{{javaPackagePath}}/exception"
    },
    {
      "type": "directory",
      "path": "src/main/java/{{javaPackagePath}}/config"
    },
    {
      "type": "file",
      "path": "build.gradle.kts",
      "source": "template/build.gradle.kts"
    },
    {
      "type": "file",
      "path": "settings.gradle.kts",
      "source": "template/settings.gradle.kts"
    },
    {
      "type": "file",
      "path": "gradlew",
      "source": "template/gradlew",
      "executable": true
    },
    {
      "type": "file",
      "path": "gradlew.bat",
      "source": "template/gradlew.bat"
    },
    {
      "type": "file",
      "path": "gradle/wrapper/gradle-wrapper.properties",
      "source": "template/gradle/wrapper/gradle-wrapper.properties"
    },
    {
      "type": "file",
      "path": "gradle/wrapper/gradle-wrapper.jar",
      "source": "template/gradle/wrapper/gradle-wrapper.jar",
      "binary": true
    },
    {
      "type": "file",
      "path": "README.md",
      "source": "template/README.md"
    },
    {
      "type": "file",
      "path": ".gitignore",
      "source": "template/gitignore"
    },
    {
      "type": "file",
      "path": "src/main/resources/application.yml",
      "source": "template/src/main/resources/application.yml"
    },
    {
      "type": "file",
      "path": "src/main/java/{{javaPackagePath}}/Application.java",
      "source": "template/src/main/java/Application.java"
    },
    {
      "type": "file",
      "path": "src/main/java/{{javaPackagePath}}/controller/HealthController.java",
      "source": "template/src/main/java/controller/HealthController.java"
    },
    {
      "type": "file",
      "path": "src/main/java/{{javaPackagePath}}/service/HealthService.java",
      "source": "template/src/main/java/service/HealthService.java"
    },
    {
      "type": "file",
      "path": "src/test/java/{{javaPackagePath}}/ApplicationTests.java",
      "source": "template/src/test/java/ApplicationTests.java"
    }
  ]
}
