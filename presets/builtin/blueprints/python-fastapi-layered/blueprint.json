{
  "schemaVersion": 1,
  "id": "python-fastapi-layered",
  "version": "1.0.0",
  "name": "FastAPI Layered",
  "description": "Layered FastAPI architecture with API, services, repositories, and core modules.",
  "projectType": "backend-service",
  "language": "python",
  "framework": "fastapi",
  "organization": "layered",
  "supportedMaturities": ["prototype", "standard", "operational"],
  "defaultMaturity": "standard",
  "supportedCapabilities": [
    "unit-tests",
    "integration-tests",
    "docker",
    "docker-compose",
    "github-actions",
    "postgres",
    "redis",
    "kafka",
    "structured-logging",
    "opentelemetry",
    "documentation-showcase"
  ],
  "variables": [
    {
      "name": "projectName",
      "prompt": "Project name",
      "type": "string",
      "required": true,
      "transform": "kebab"
    },
    {
      "name": "pythonPackageName",
      "prompt": "Python package name",
      "type": "string",
      "default": "{{projectName}}",
      "transform": "snake"
    }
  ],
  "entries": [
    {
      "type": "directory",
      "path": "src/{{pythonPackageName}}/repositories"
    },
    {
      "type": "directory",
      "path": "src/{{pythonPackageName}}/models"
    },
    {
      "type": "directory",
      "path": "src/{{pythonPackageName}}/infrastructure"
    },
    {
      "type": "directory",
      "path": "tests/unit"
    },
    {
      "type": "directory",
      "path": "tests/integration"
    },
    {
      "type": "file",
      "path": "pyproject.toml",
      "source": "template/pyproject.toml"
    },
    {
      "type": "file",
      "path": "README.md",
      "source": "template/README.md"
    },
    {
      "type": "file",
      "path": ".gitignore",
      "source": "template/gitignore"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/__init__.py",
      "source": "template/src/__init__.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/main.py",
      "source": "template/src/main.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/core/__init__.py",
      "source": "template/src/core/__init__.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/core/config.py",
      "source": "template/src/core/config.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/core/errors.py",
      "source": "template/src/core/errors.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/api/__init__.py",
      "source": "template/src/api/__init__.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/api/routes/__init__.py",
      "source": "template/src/api/routes/__init__.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/api/routes/health.py",
      "source": "template/src/api/routes/health.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/services/__init__.py",
      "source": "template/src/services/__init__.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/services/health_service.py",
      "source": "template/src/services/health_service.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/schemas/__init__.py",
      "source": "template/src/schemas/__init__.py"
    },
    {
      "type": "file",
      "path": "src/{{pythonPackageName}}/schemas/health.py",
      "source": "template/src/schemas/health.py"
    },
    {
      "type": "file",
      "path": "tests/unit/test_health.py",
      "source": "template/tests/unit/test_health.py"
    }
  ]
}
