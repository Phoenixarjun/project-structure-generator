{
  "schemaVersion": 1,
  "id": "python-django-domain-apps",
  "version": "1.0.0",
  "name": "Django Domain Apps",
  "description": "Django apps grouped around business capabilities with services and selectors.",
  "projectType": "backend-service",
  "language": "python",
  "framework": "django",
  "organization": "domain-apps",
  "supportedMaturities": ["prototype", "standard", "operational"],
  "defaultMaturity": "standard",
  "supportedCapabilities": [
    "unit-tests",
    "integration-tests",
    "docker",
    "docker-compose",
    "github-actions",
    "postgres",
    "redis",
    "structured-logging",
    "opentelemetry",
    "documentation-showcase"
  ],
  "variables": [
    {
      "name": "projectName",
      "prompt": "Project name",
      "type": "string",
      "required": true,
      "transform": "kebab"
    },
    {
      "name": "pythonPackageName",
      "prompt": "Python package name",
      "type": "string",
      "default": "{{projectName}}",
      "transform": "snake"
    }
  ],
  "featureTemplate": {
    "variables": ["featureName"],
    "entries": [
      {
        "type": "directory",
        "path": "src/apps/{{featureNameSnake}}"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/__init__.py",
        "content": ""
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/models.py",
        "content": "from django.db import models\n"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/services.py",
        "content": "class {{featureNamePascal}}Service:\n    pass\n"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/selectors.py",
        "content": "def get_{{featureNameSnake}}_by_id(item_id: int):\n    return None\n"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/api.py",
        "content": "def {{featureNameSnake}}_endpoint(request):\n    return {}\n"
      },
      {
        "type": "file",
        "path": "src/apps/{{featureNameSnake}}/tests.py",
        "content": "from django.test import TestCase\n\nclass {{featureNamePascal}}DomainTestCase(TestCase):\n    pass\n"
      }
    ]
  },
  "entries": [
    {
      "type": "directory",
      "path": "src/apps"
    },
    {
      "type": "file",
      "path": "pyproject.toml",
      "source": "template/pyproject.toml"
    },
    {
      "type": "file",
      "path": "manage.py",
      "source": "template/manage.py"
    },
    {
      "type": "file",
      "path": "README.md",
      "source": "template/README.md"
    },
    {
      "type": "file",
      "path": ".gitignore",
      "source": "template/gitignore"
    },
    {
      "type": "file",
      "path": "src/config/__init__.py",
      "source": "template/src/config/__init__.py"
    },
    {
      "type": "file",
      "path": "src/config/urls.py",
      "source": "template/src/config/urls.py"
    },
    {
      "type": "file",
      "path": "src/config/settings/__init__.py",
      "source": "template/src/config/settings/__init__.py"
    },
    {
      "type": "file",
      "path": "src/config/settings/base.py",
      "source": "template/src/config/settings/base.py"
    }
  ]
}
