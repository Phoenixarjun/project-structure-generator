{
  "schemaVersion": 1,
  "id": "opentelemetry",
  "name": "OpenTelemetry Tracing",
  "category": "observability",
  "description": "Adds OpenTelemetry tracing middleware and instrumentation.",
  "entries": [
    {
      "type": "file",
      "path": "config/otel.json",
      "source": "template/otel.json"
    }
  ],
  "contributions": [
    {
      "extensionPointId": "application-imports",
      "content": "# OpenTelemetry Tracing\nimport logging"
    },
    {
      "extensionPointId": "application-bootstrap",
      "content": "# OpenTelemetry Bootstrap Setup\nlogging.info('OpenTelemetry initialized')"
    }
  ]
}
