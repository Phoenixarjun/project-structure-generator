{
  "schemaVersion": 1,
  "id": "typescript-cli-modular",
  "version": "1.0.0",
  "name": "TypeScript Modular CLI",
  "description": "A dependency-light TypeScript CLI organized by commands, core services, and tests.",
  "tags": [
    "typescript",
    "node",
    "cli",
    "modular"
  ],
  "variables": [
    {
      "name": "projectName",
      "prompt": "Project name",
      "type": "string",
      "required": true,
      "transform": "kebab"
    },
    {
      "name": "packageName",
      "prompt": "Package name",
      "type": "string",
      "default": "{{projectName}}",
      "transform": "kebab"
    },
    {
      "name": "commandName",
      "prompt": "CLI command",
      "type": "string",
      "default": "{{projectName}}",
      "transform": "kebab"
    }
  ],
  "entries": [
    {
      "type": "directory",
      "path": "src/commands"
    },
    {
      "type": "directory",
      "path": "src/core"
    },
    {
      "type": "directory",
      "path": "tests"
    },
    {
      "type": "file",
      "path": "package.json",
      "source": "template/package.json"
    },
    {
      "type": "file",
      "path": "tsconfig.json",
      "source": "template/tsconfig.json"
    },
    {
      "type": "file",
      "path": ".gitignore",
      "source": "template/gitignore"
    },
    {
      "type": "file",
      "path": "README.md",
      "source": "template/README.md"
    },
    {
      "type": "file",
      "path": "src/cli.ts",
      "source": "template/src/cli.ts",
      "mode": 493
    },
    {
      "type": "file",
      "path": "src/index.ts",
      "source": "template/src/index.ts"
    },
    {
      "type": "file",
      "path": "src/core/errors.ts",
      "source": "template/src/core/errors.ts"
    },
    {
      "type": "file",
      "path": "src/commands/hello.ts",
      "source": "template/src/commands/hello.ts"
    },
    {
      "type": "file",
      "path": "tests/hello.test.ts",
      "source": "template/tests/hello.test.ts"
    }
  ],
  "metadata": {
    "language": "TypeScript",
    "framework": "Node.js",
    "architecture": "Modular CLI"
  }
}
