{
  "schemaVersion": 1,
  "id": "python-fastapi-clean",
  "version": "1.0.0",
  "name": "Python FastAPI Clean Architecture",
  "description": "A direct src layout separating API, application, domain, infrastructure, observability, and shared primitives.",
  "tags": [
    "python",
    "fastapi",
    "clean-architecture",
    "backend"
  ],
  "variables": [
    {
      "name": "projectName",
      "prompt": "Project name",
      "type": "string",
      "required": true,
      "transform": "kebab"
    },
    {
      "name": "packageName",
      "prompt": "Python package name",
      "type": "string",
      "default": "{{projectName}}",
      "transform": "snake"
    },
    {
      "name": "includeDocker",
      "prompt": "Include Dockerfile",
      "type": "boolean",
      "default": true
    }
  ],
  "entries": [
    {
      "type": "directory",
      "path": "src/{{packageName}}/api"
    },
    {
      "type": "directory",
      "path": "src/{{packageName}}/application"
    },
    {
      "type": "directory",
      "path": "src/{{packageName}}/domain"
    },
    {
      "type": "directory",
      "path": "src/{{packageName}}/infrastructure"
    },
    {
      "type": "directory",
      "path": "src/{{packageName}}/observability"
    },
    {
      "type": "directory",
      "path": "src/{{packageName}}/shared"
    },
    {
      "type": "directory",
      "path": "tests/unit"
    },
    {
      "type": "directory",
      "path": "tests/integration"
    },
    {
      "type": "file",
      "path": "pyproject.toml",
      "source": "template/pyproject.toml"
    },
    {
      "type": "file",
      "path": "README.md",
      "source": "template/README.md"
    },
    {
      "type": "file",
      "path": ".gitignore",
      "source": "template/gitignore"
    },
    {
      "type": "file",
      "path": "Dockerfile",
      "source": "template/Dockerfile",
      "when": {
        "variable": "includeDocker",
        "equals": true
      }
    },
    {
      "type": "file",
      "path": "src/{{packageName}}/__init__.py",
      "content": ""
    },
    {
      "type": "file",
      "path": "src/{{packageName}}/main.py",
      "source": "template/src/main.py"
    },
    {
      "type": "file",
      "path": "src/{{packageName}}/api/__init__.py",
      "content": ""
    },
    {
      "type": "file",
      "path": "src/{{packageName}}/api/router.py",
      "source": "template/src/api/router.py"
    },
    {
      "type": "file",
      "path": "src/{{packageName}}/application/__init__.py",
      "content": ""
    },
    {
      "type": "file",
      "path": "src/{{packageName}}/domain/__init__.py",
      "content": ""
    },
    {
      "type": "file",
      "path": "src/{{packageName}}/infrastructure/__init__.py",
      "content": ""
    },
    {
      "type": "file",
      "path": "src/{{packageName}}/observability/__init__.py",
      "content": ""
    },
    {
      "type": "file",
      "path": "src/{{packageName}}/shared/__init__.py",
      "content": ""
    },
    {
      "type": "file",
      "path": "tests/unit/test_health.py",
      "source": "template/tests/test_health.py"
    }
  ],
  "metadata": {
    "language": "Python",
    "framework": "FastAPI",
    "architecture": "Clean Architecture"
  }
}
