{
  "schemaVersion": 1,
  "id": "java-spring-feature-modular",
  "version": "1.0.0",
  "name": "Java Spring Boot Feature Modular",
  "description": "A modular-monolith starting point that groups API, application, domain, and infrastructure code under a feature package.",
  "tags": [
    "java",
    "spring-boot",
    "gradle",
    "feature-based",
    "modular-monolith"
  ],
  "variables": [
    {
      "name": "projectName",
      "prompt": "Project name",
      "type": "string",
      "required": true,
      "transform": "kebab"
    },
    {
      "name": "artifactId",
      "prompt": "Gradle artifact id",
      "type": "string",
      "default": "{{projectName}}",
      "transform": "kebab"
    },
    {
      "name": "groupId",
      "prompt": "Java group id",
      "type": "string",
      "default": "com.example",
      "transform": "java-package"
    },
    {
      "name": "basePackage",
      "prompt": "Java base package",
      "type": "string",
      "default": "{{groupId}}.{{artifactId}}",
      "transform": "java-package"
    },
    {
      "name": "basePackagePath",
      "prompt": "Java package path",
      "type": "string",
      "default": "{{basePackage}}",
      "transform": "java-path",
      "internal": true
    },
    {
      "name": "applicationClass",
      "prompt": "Application class",
      "type": "string",
      "default": "{{artifactId}}",
      "transform": "pascal",
      "internal": true
    },
    {
      "name": "featureName",
      "prompt": "Initial feature name",
      "type": "string",
      "default": "core",
      "transform": "snake"
    }
  ],
  "entries": [
    {
      "type": "directory",
      "path": "src/main/java/{{basePackagePath}}/{{featureName}}/api"
    },
    {
      "type": "directory",
      "path": "src/main/java/{{basePackagePath}}/{{featureName}}/application"
    },
    {
      "type": "directory",
      "path": "src/main/java/{{basePackagePath}}/{{featureName}}/domain"
    },
    {
      "type": "directory",
      "path": "src/main/java/{{basePackagePath}}/{{featureName}}/infrastructure"
    },
    {
      "type": "directory",
      "path": "src/main/java/{{basePackagePath}}/shared"
    },
    {
      "type": "directory",
      "path": "src/main/resources"
    },
    {
      "type": "directory",
      "path": "src/test/java/{{basePackagePath}}/{{featureName}}"
    },
    {
      "type": "file",
      "path": "settings.gradle.kts",
      "source": "template/settings.gradle.kts"
    },
    {
      "type": "file",
      "path": "build.gradle.kts",
      "source": "template/build.gradle.kts"
    },
    {
      "type": "file",
      "path": "gradlew",
      "source": "template/gradlew",
      "mode": 493
    },
    {
      "type": "file",
      "path": "gradlew.bat",
      "source": "template/gradlew.bat"
    },
    {
      "type": "file",
      "path": "gradle/wrapper/gradle-wrapper.properties",
      "source": "template/gradle/wrapper/gradle-wrapper.properties"
    },
    {
      "type": "file",
      "path": "gradle/wrapper/gradle-wrapper.jar",
      "source": "template/gradle/wrapper/gradle-wrapper.jar",
      "template": false
    },
    {
      "type": "file",
      "path": ".gitignore",
      "source": "template/gitignore"
    },
    {
      "type": "file",
      "path": "README.md",
      "source": "template/README.md"
    },
    {
      "type": "file",
      "path": "src/main/java/{{basePackagePath}}/{{applicationClass}}Application.java",
      "source": "template/Application.java"
    },
    {
      "type": "file",
      "path": "src/main/java/{{basePackagePath}}/{{featureName}}/api/HealthController.java",
      "source": "template/HealthController.java"
    },
    {
      "type": "file",
      "path": "src/main/java/{{basePackagePath}}/{{featureName}}/application/HealthQuery.java",
      "source": "template/HealthQuery.java"
    },
    {
      "type": "file",
      "path": "src/main/java/{{basePackagePath}}/{{featureName}}/domain/HealthStatus.java",
      "source": "template/HealthStatus.java"
    },
    {
      "type": "file",
      "path": "src/main/resources/application.yml",
      "source": "template/application.yml"
    }
  ],
  "metadata": {
    "language": "Java",
    "framework": "Spring Boot",
    "architecture": "Modular Monolith",
    "organization": "Package by feature"
  }
}
