{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PhoenixArjun/project-structure-generator/schema/pack.schema.json",
  "title": "Project Structure Generator Capability Pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "category",
    "description"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "compatibleWith": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frameworks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blueprints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "maturities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "conflictsWith": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string" }
    },
    "variables": {
      "type": "array",
      "items": { "type": "object" }
    },
    "directories": {
      "type": "array",
      "items": { "type": "object" }
    },
    "files": {
      "type": "array",
      "items": { "type": "object" }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["extensionPointId", "content"],
        "additionalProperties": false,
        "properties": {
          "extensionPointId": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    }
  }
}
